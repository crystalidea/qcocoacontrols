########################################################################
# Standalone qmake configuration for building qcocoacontrols and its
# testapp straight from a GitHub checkout.
#
# This is a trimmed copy of the build include used in the author's own
# source tree. The helper functions and cross-project library paths of
# that file are deliberately left out -- they only make sense there.
#
# Build directory naming, the deployment target and the compiler switches
# ARE kept identical to it, so both files resolve to the same paths and a
# build configured half by one and half by the other still finds the
# library. Two differences are deliberate. The language level is C++17
# here (nothing in this library needs more) where the internal file uses
# C++20, so do not reuse one build directory across the two without
# cleaning it first. And the architecture is detected from Qt here, while
# the internal file always builds the slices of its prebuilt third-party
# tree (arm64 debug, universal release).
########################################################################

CONFIG += precompile_header

CONFIG(debug, debug|release) {
    BUILD = debug
    CONFIG += DEBUG
}

CONFIG(release, debug|release) {
    BUILD = release
    CONFIG += RELEASE
}

lessThan(QT_MAJOR_VERSION, 6) {
    error("qcocoacontrols requires Qt 6, this is Qt $$QT_VERSION")
}

########################################################################
# detect an arm build of Qt
#
# qmake itself is always arm64 on Apple Silicon even when Qt was built
# for x86_64, so ask a tool that is not qmake.
########################################################################

MACDEPLOYQT = $$[QT_INSTALL_BINS]/macdeployqt

ARM_BUILD_TEST = $$system(lipo -info $$shell_quote($$MACDEPLOYQT) 2>/dev/null)

# macdeployqt is missing from minimal Qt installs and the probe also fails on
# install paths containing spaces. An empty result must NOT be read as "Qt is
# x86_64" -- that would force x86_64 onto an arm64 Qt and fail at link time
# with no hint why. Fall back to the architectures Qt reports about itself:
# QT_ARCHS lists every slice of a multi-architecture Qt, QT_ARCH only one.

isEmpty(ARM_BUILD_TEST): ARM_BUILD_TEST = $$QT_ARCHS $$QT_ARCH

contains(ARM_BUILD_TEST, arm64) {

    RELEASE {
        CPU_ARCH = arm64_x86_64

        QMAKE_APPLE_DEVICE_ARCHS = arm64 x86_64
    }
    DEBUG {
        CPU_ARCH = arm64

        QMAKE_APPLE_DEVICE_ARCHS = arm64 # arm64 alone is enough for a debug build and compiles faster
    }
}
else {
    CPU_ARCH = x86_64

    QMAKE_APPLE_DEVICE_ARCHS = x86_64
}

########################################################################
# Xcode SDK
#
# Do NOT pin QMAKE_MAC_SDK to a versioned SDK such as macosx11.1:
# sdk.prf calls error() when it cannot resolve the name, so the build
# stops dead on every Xcode that no longer ships that exact version.
# Leaving it unset means plain 'macosx', which resolves to whatever is
# installed. sdk_no_version_check only silences the "SDK is newer than
# Qt was tested with" warning -- it does not help with a missing SDK.
########################################################################

CONFIG += sdk_no_version_check

########################################################################
# build directories, deployment target and language level
########################################################################

BUILD_DIR_NO_QT = "$$BUILD-$$CPU_ARCH"

!isEmpty( QT ) {
    BUILD_DIR = "$$BUILD-$$QT_VERSION-$$CPU_ARCH"

    MOC_DIR = "$$BUILD_DIR/moc"
    RCC_DIR = "$$BUILD_DIR/rcc"
    UI_DIR = "$$BUILD_DIR/ui"
}
else {
    BUILD_DIR = "$$BUILD_DIR_NO_QT"
}

QMAKE_MACOSX_DEPLOYMENT_TARGET = 12 # required by Qt 6.8
CONFIG += c++17

# Apple clang 21 (Xcode 26.4 and later) reports __yield as a builtin on arm64
# but leaves it undeclared without <arm_acle.h>, so qyieldcpu.h of Qt 6.8 does
# not compile. The error is not raised inside system headers, hence the Qt
# include directory is passed with -isystem as well, the way CMake does it.

QMAKE_CXXFLAGS += -isystem $$shell_quote($$[QT_INSTALL_HEADERS])
QMAKE_CFLAGS += -isystem $$shell_quote($$[QT_INSTALL_HEADERS])

OBJECTS_DIR = "$$BUILD_DIR/obj"
DESTDIR = $$BUILD_DIR # can be overridden
# OBJECTS_DIR above is what actually places the object files. The -o below is
# kept only for parity with the internal build file; the compile rule appends
# its own -o after CXXFLAGS, so this one is always overridden.

QMAKE_CXXFLAGS += "-o $$OBJECTS_DIR"

# static libraries related stuff

staticlib {
    CONFIG += no_warn_empty_obj_files
}
